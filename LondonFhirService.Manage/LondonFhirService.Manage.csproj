<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<SpaRoot>..\LondonFhirService.Manage.Client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:6073</SpaProxyServerUrl>
		<Version>0.9.0.0</Version>
		<AssemblyVersion>0.9.0.0</AssemblyVersion>
		<FileVersion>0.9.0.0</FileVersion>
		<PackageReleaseNotes>
			Initial release of the London FHIR Service Management Website.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Attrify" Version="0.0.0.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="FluentAssertions" Version="[7.2.2]" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
		<PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
		<!--
			Pin Microsoft.OpenApi to the latest 2.x. Do NOT move to 3.x: the
			.NET 10 Microsoft.AspNetCore.OpenApi source generator is built against
			the OpenApi 2.x API (3.x makes IOpenApiMediaType.Example read-only,
			breaking the generated XML-comment support). 2.x latest also clears NU1903
			(high severity advisory GHSA-v5pm-xwqc-g5wc) on the transitive 2.4.1.
		-->
		<PackageReference Include="Microsoft.OpenApi" Version="[2.11.0]" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
		<PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
		<PackageReference Include="NHSISL.CsvHelperClient" Version="3.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LondonFhirService.Core\LondonFhirService.Core.csproj" />
		<ProjectReference Include="..\LondonFhirService.Clients.AuditAndMetrics\LondonFhirService.Clients.AuditAndMetrics.csproj" />

		<!--
			The SPA this host serves. SpaRoot, SpaProxyServerUrl and SpaProxyLaunchCommand above
			are meaningless without it: the reference is what tells Visual Studio the JavaScript
			project belongs to this web app rather than being a launchable web server in its own
			right. ReferenceOutputAssembly is false because a JavaScript project produces no
			assembly to reference - this exists purely to establish the relationship and the
			build order. Conditioned to Visual Studio only: a command line dotnet restore
			cannot restore the JavaScript SDK esproj and fails with NU1105.
		-->
		<ProjectReference
			Include="..\LondonFhirService.Manage.Client\LondonFhirService.Manage.Client.esproj"
			Condition="'$(BuildingInsideVisualStudio)' == 'true'">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LondonFhirService.Manage.Tests.Acceptance" />
		<InternalsVisibleTo Include="LondonFhirService.Manage.Tests.Integration" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Update="appsettings.Development.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="appsettings.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
